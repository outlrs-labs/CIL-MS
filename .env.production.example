# Copy to .env.production on EC2 and keep it out of Git.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ADMIN_EMAIL=admin@cil.com
ADMIN_PASSWORD=
ADMIN_NAME=CIL Administrator
ADMIN_USER_ID=

# Use the final CloudFront URL, with no trailing slash.
CORS_ORIGINS=https://YOUR_DISTRIBUTION.cloudfront.net
WORKBENCH_COOKIE_SECURE=true
DF_BRIDGE_SECRET=
POSTGRES_PASSWORD=
ORIGIN_VERIFY_HEADER=

DF_SANDBOX=local
CIL_PRIMARY_PROVIDER=sarvam
CIL_FALLBACK_PROVIDER=gemini
SARVAM_ENABLED=false
SARVAM_ENDPOINT=openai
SARVAM_API_KEY=
SARVAM_API_BASE=https://api.sarvam.ai/v1
SARVAM_MODELS=sarvam-105b
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.5-flash
