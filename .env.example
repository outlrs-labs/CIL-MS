# Copy into .env. Never commit actual keys/passwords.
SUPABASE_URL=
# Supabase legacy anon key OR new publishable key (safe for browser)
SUPABASE_PUBLISHABLE_KEY=
# Backend/bootstrap ONLY: legacy service_role key OR new secret key
SUPABASE_SECRET_KEY=
CORS_ORIGINS=http://localhost:5173
# Initial singleton administrator. No default password is shipped.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=CIL Administrator
# Optional: explicitly bind an existing Auth user instead of creating one.
ADMIN_USER_ID=
# Vite reads this root .env. NEVER prefix backend secrets with VITE_.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_URL=http://localhost:8000
# Read-only synthetic UI preview; available only in Vite development.
VITE_ENABLE_UI_PREVIEW=true

DF_URL=http://127.0.0.1:5567
DF_BRIDGE_SECRET=
# Defaults stay inside this checkout: ./Data/cil and ./Data/.processing.
# CIL_DATA_ROOT=/absolute/override/path/Data/cil
# CIL_PROCESSING_ROOT=/absolute/override/path/Data/.processing
DF_SANDBOX=local
# Environment-backed credentials remain server-side. The private workbench
# builds CIL Auto from this primary provider and Gemini as its first fallback.
CIL_PRIMARY_PROVIDER=sarvam
CIL_FALLBACK_PROVIDER=gemini
SARVAM_ENABLED=false
SARVAM_ENDPOINT=openai
SARVAM_API_KEY=
SARVAM_API_BASE=https://api.sarvam.ai/v1
SARVAM_MODELS=sarvam-105b
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODELS=
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.5-flash
